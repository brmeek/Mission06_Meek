@model Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<h1 class="mb-4">Edit Movie</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Movie" asp-action="Edit" method="post">
    <input type="hidden" asp-for="MovieId" />
    <partial name="_MovieFormFields" model="Model" />

    <button type="submit" class="btn btn-primary">Update Movie</button>
    <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

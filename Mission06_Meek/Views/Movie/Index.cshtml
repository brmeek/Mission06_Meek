@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Movie Collection</h1>
    <a asp-controller="Movie" asp-action="Add" class="btn btn-success">Add New Movie</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Year</th>
                <th>Director</th>
                <th>Rating</th>
                <th>Edited</th>
                <th>Copied to Plex</th>
                <th>Lent To</th>
                <th>Notes</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@(movie.Category?.CategoryName ?? "")</td>
                    <td>@movie.Year</td>
                    <td>@movie.Director</td>
                    <td>@movie.Rating</td>
                    <td>@(movie.Edited ? "Yes" : "No")</td>
                    <td>@(movie.CopiedToPlex ? "Yes" : "No")</td>
                    <td>@movie.LentTo</td>
                    <td>@movie.Notes</td>
                    <td class="text-center">
                        <a asp-controller="Movie" asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-sm btn-primary me-2">Edit</a>
                        <a asp-controller="Movie" asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
